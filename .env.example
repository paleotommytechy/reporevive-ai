# Backend (load into your shell or backend/.env)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
# Cloud AI inference: keep this key on the BACKEND only, never in VITE_* vars
AI_PROVIDER=gemma
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
# Optional, raises GitHub API rate limits. Never commit your token.
GITHUB_TOKEN=

# Frontend: put in frontend/.env.local
VITE_API_BASE_URL=http://localhost:8000
